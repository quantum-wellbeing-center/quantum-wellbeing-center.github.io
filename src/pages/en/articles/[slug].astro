---
/**
 * English article pages: `/en/articles/<slug>/`. Drafts are never built.
 */
import type { GetStaticPaths } from 'astro';
import ArticlePage from '../../../components/pages/ArticlePage.astro';
import { articleSlug, getArticles, type ArticleEntry } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const articles = await getArticles('en');
  return articles.map((entry) => ({ params: { slug: articleSlug(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: ArticleEntry };
---

<ArticlePage lang="en" entry={entry} />
