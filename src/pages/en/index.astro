---
/**
 * Temporary English home page that exercises BaseLayout. Phase 4 replaces it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import { site } from '../../config/site';
import { getRoute, useTranslations } from '../../i18n';

const lang = 'en';
const t = useTranslations(lang);
// TODO(content): home page copy comes in Phase 4.
---

<BaseLayout lang={lang} pageKey="home" title={site.tagline.en} description={site.tagline.en}>
  <Section class="hero">
    <div class="hero__inner">
      <h1 class="text-display">{site.tagline.en}</h1>
      <p class="hero__lead text-title-3 text-secondary">
        A calm space for relaxation and wellbeing.
      </p>
      <div class="hero__actions">
        <Button href={site.bookingUrl} size="lg" newTabLabel={t('a11y.newTab')}>
          {t('actions.bookSession')}
        </Button>
        <Button
          href={getRoute(lang, 'technology')}
          variant="secondary"
          size="lg"
          icon="arrow-right"
        >
          {t('actions.howItWorks')}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .hero__inner {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }
  .hero__lead {
    font-weight: 400;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
