---
/**
 * Logo: placeholder mark plus the brand name.
 * TODO(content): replace the inline mark with the owner's logo (src/assets/brand/logo.svg).
 */
import { site } from '../config/site';

interface Props {
  /** Hide the wordmark and show only the mark. */
  markOnly?: boolean;
  size?: number;
  class?: string;
}

const { markOnly = false, size = 28, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg
    class="logo__mark"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="16" cy="16" r="3.5" fill="currentColor" stroke="none"></circle>
    <path d="M8.5 23.5a10.6 10.6 0 0 1 0-15"></path>
    <path d="M23.5 8.5a10.6 10.6 0 0 1 0 15"></path>
    <path d="M4 28a16.9 16.9 0 0 1 0-24"></path>
    <path d="M28 4a16.9 16.9 0 0 1 0 24"></path>
  </svg>
  {!markOnly && <span class="logo__word">{site.brandName}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--label);
    font-weight: 600;
    font-size: var(--text-headline);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo__mark {
    color: var(--accent);
  }
</style>
