---
/**
 * Sticky header with a translucent material bar. Rendered exactly once by BaseLayout.
 * The nav, language switcher, phone link (small screens only, where the top bar is hidden)
 * and the "Rezervă" BookingLink live inside the MobileMenu sheet wrapper, which becomes
 * `display: contents` on desktop so there is a single copy of every link.
 * Nav items come from `primaryNav` in routes.ts and their `nav.*` labels; nothing is hard-coded.
 */
import { site } from '../config/site';
import {
  getRoute,
  primaryNav,
  useTranslations,
  type Locale,
  type PageKey,
  type RouteParams,
} from '../i18n';
import BookingLink from './BookingLink.astro';
import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import MobileMenu from './islands/MobileMenu.astro';

interface Props {
  lang: Locale;
  pageKey: PageKey;
  params?: RouteParams;
  alternateUrl?: string | null;
}

const { lang, pageKey, params, alternateUrl } = Astro.props;
const t = useTranslations(lang);

/** The nav item that counts as active for the current page. */
const navItems = primaryNav.map((key) => ({
  key,
  href: getRoute(lang, key),
  label: t(`nav.${key}`),
  current: key === pageKey,
}));
---

<header class="site-header" data-header>
  <div class="site-header__bar">
    <Container>
      <div class="site-header__inner">
        <a
          class="site-header__brand"
          href={getRoute(lang, 'home')}
          aria-label={t('a11y.brandHome', { brand: site.brandName })}
          aria-current={pageKey === 'home' ? 'page' : undefined}
        >
          <Logo />
        </a>

        <MobileMenu lang={lang}>
          <nav class="primary-nav" aria-label={t('a11y.mainNavigation')}>
            <ul class="primary-nav__list" role="list">
              {navItems.map((item) => (
                <li>
                  <a
                    class="primary-nav__link"
                    href={item.href}
                    aria-current={item.current ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="site-header__actions">
            <a class="site-header__phone" href={`tel:${site.phoneHref}`}>
              <Icon name="phone" size={18} />
              <span>{site.phone}</span>
            </a>
            <LanguageSwitcher
              lang={lang}
              pageKey={pageKey}
              params={params}
              alternateUrl={alternateUrl}
            />
            <BookingLink
              lang={lang}
              size="sm"
              icon="whatsapp"
              iconPosition="start"
              class="site-header__book"
            >
              {t('actions.book')}
            </BookingLink>
          </div>
        </MobileMenu>
      </div>
    </Container>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }
  /* The material (backdrop-filter) lives on a pseudo-element, not on the bar itself:
     backdrop-filter turns an element into the containing block for fixed descendants,
     which would pin the mobile sheet to the bar instead of the viewport. */
  .site-header__bar {
    position: relative;
    z-index: 2;
    isolation: isolate;
    border-bottom: 1px solid var(--separator);
  }
  .site-header__bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--material);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
  }
  @supports not (backdrop-filter: blur(1px)) {
    .site-header__bar::before {
      background: var(--material-fallback);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header__bar::before {
      background: var(--material-fallback);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    min-height: var(--header-height);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: inherit;
    text-decoration: none;
    margin-inline-end: auto;
  }
  .site-header__brand:focus-visible {
    border-radius: var(--radius-sm);
  }

  .primary-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .primary-nav__link {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--label);
    font-size: var(--text-title-3);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  .primary-nav__link:hover {
    background: var(--fill);
  }
  .primary-nav__link[aria-current='page'] {
    color: var(--accent);
  }

  .site-header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--separator);
  }
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--touch-target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-capsule);
    color: var(--label);
    font-weight: 600;
    text-decoration: none;
  }
  .site-header__phone:hover {
    background: var(--fill);
  }

  /* Same breakpoint as MobileMenu.astro and TopBar.astro. */
  @media (min-width: 72em) {
    .site-header__inner {
      flex-wrap: nowrap;
    }
    .site-header__brand {
      margin-inline-end: 0;
      flex-shrink: 0;
    }
    .primary-nav {
      flex: 1;
      display: flex;
      justify-content: center;
      min-width: 0;
    }
    .primary-nav__list {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0 var(--space-1);
    }
    .primary-nav__link {
      min-height: var(--header-height);
      padding: 0 var(--space-3);
      border-radius: 0;
      font-size: var(--text-subheadline);
      font-weight: 500;
      position: relative;
    }
    .primary-nav__link:hover {
      background: none;
      color: var(--accent);
    }
    .primary-nav__link[aria-current='page']::after {
      content: '';
      position: absolute;
      inset-inline: var(--space-3);
      bottom: 0;
      height: 2px;
      background: var(--accent);
      border-radius: 1px;
    }
    .site-header__actions {
      flex-wrap: nowrap;
      margin: 0;
      padding: 0;
      border: 0;
      gap: var(--space-2);
    }
    .site-header__phone {
      display: none;
    }
  }
</style>
