---
/**
 * Icon: wraps Lucide icons (outline, one stroke weight) plus a few locally drawn brand glyphs
 * that Lucide no longer ships (Facebook, Instagram, YouTube, TikTok, WhatsApp).
 *
 * Decorative by default (aria-hidden). Pass `label` to make it an accessible image.
 * Icons are imported statically so only the ones used end up in the bundle.
 */
import type { HTMLAttributes } from 'astro/types';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CalendarCheck from '@lucide/astro/icons/calendar-check';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import CircleAlert from '@lucide/astro/icons/circle-alert';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Clock from '@lucide/astro/icons/clock';
import Cookie from '@lucide/astro/icons/cookie';
import ExternalLink from '@lucide/astro/icons/external-link';
import FileText from '@lucide/astro/icons/file-text';
import Globe from '@lucide/astro/icons/globe';
import Info from '@lucide/astro/icons/info';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Menu from '@lucide/astro/icons/menu';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Phone from '@lucide/astro/icons/phone';
import Search from '@lucide/astro/icons/search';
import Send from '@lucide/astro/icons/send';
import Settings2 from '@lucide/astro/icons/settings-2';
import Sparkles from '@lucide/astro/icons/sparkles';
import Star from '@lucide/astro/icons/star';
import X from '@lucide/astro/icons/x';

const lucide = {
  'arrow-right': ArrowRight,
  'arrow-up-right': ArrowUpRight,
  'calendar-check': CalendarCheck,
  check: Check,
  'chevron-down': ChevronDown,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  'circle-alert': CircleAlert,
  'circle-check': CircleCheck,
  clock: Clock,
  cookie: Cookie,
  'external-link': ExternalLink,
  'file-text': FileText,
  globe: Globe,
  info: Info,
  mail: Mail,
  'map-pin': MapPin,
  menu: Menu,
  'message-circle': MessageCircle,
  phone: Phone,
  search: Search,
  send: Send,
  'settings-2': Settings2,
  sparkles: Sparkles,
  star: Star,
  x: X,
} as const;

/** Brand glyphs drawn in the Lucide style (24x24 grid, round caps, stroke 2). */
const brand = {
  facebook: ['M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z'],
  instagram: [
    'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5z',
    'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z',
    'M17.5 6.5h.01',
  ],
  youtube: [
    'M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17',
    'm10 15 5-3-5-3z',
  ],
  tiktok: ['M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5'],
  whatsapp: [
    'M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21',
    'M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1',
  ],
} as const;

export type IconName = keyof typeof lucide | keyof typeof brand;

export interface Props extends Omit<
  HTMLAttributes<'svg'>,
  'class' | 'color' | 'title' | 'stroke-width'
> {
  name: IconName;
  /** Pixel size; the icon also scales with font-size when `size` is omitted. */
  size?: number;
  /** Accessible label. Without it the icon is decorative (aria-hidden). */
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className, ...rest } = Astro.props;
const strokeWidth = 1.75;

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true', focusable: 'false' } as const);

const isBrand = name in brand;
const LucideIcon = isBrand ? null : lucide[name as keyof typeof lucide];
const brandPaths = isBrand ? brand[name as keyof typeof brand] : null;
---

{LucideIcon ? (
  <LucideIcon
    size={size}
    stroke-width={strokeWidth}
    class:list={['icon', className]}
    data-icon={name}
    {...a11y}
    {...rest}
  />
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={['icon', className]}
    data-icon={name}
    {...a11y}
    {...rest}
  >
    {brandPaths?.map((d) => (
      <path d={d} />
    ))}
  </svg>
)}

<style is:global>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.2em;
  }
</style>
