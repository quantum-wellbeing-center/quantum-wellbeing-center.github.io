---
/**
 * SegmentedControl: Apple-style segmented control built on native radio inputs,
 * so it works by keyboard (arrow keys move selection) with no JavaScript.
 *
 * A JS island can hook into it through the data attributes:
 *   [data-segmented-control="<name>"] on the fieldset
 *   input[name="<name>"][data-value="<value>"] on each option
 * and listen for `change` events on the fieldset.
 */
import type { HTMLAttributes } from 'astro/types';

export interface SegmentedOption {
  value: string;
  label: string;
  /** Optional count shown after the label. */
  count?: number;
}

export interface Props extends Omit<HTMLAttributes<'fieldset'>, 'class'> {
  /** Shared `name` of the radio group; also the data-segmented-control value. */
  name: string;
  /** Accessible group label, rendered as a visually-hidden legend unless `showLabel`. */
  label: string;
  showLabel?: boolean;
  options: SegmentedOption[];
  /** Currently selected value; defaults to the first option. */
  value?: string;
  size?: 'sm' | 'md';
  /** Stretches to the full width and lets segments wrap on narrow screens. */
  fullWidth?: boolean;
  class?: string;
}

const {
  name,
  label,
  showLabel = false,
  options,
  value,
  size = 'md',
  fullWidth = false,
  class: className,
  ...rest
} = Astro.props;

const selected = value ?? options[0]?.value;
const baseId = `seg-${name}`;
---

<fieldset
  class:list={['segmented', `segmented--${size}`, { 'segmented--full': fullWidth }, className]}
  data-segmented-control={name}
  {...rest}
>
  <legend class:list={['segmented__legend', { 'visually-hidden': !showLabel }]}>{label}</legend>
  <div class="segmented__track" role="presentation">
    {options.map((option) => {
      const id = `${baseId}-${option.value}`;
      return (
        <div class="segmented__item">
          <input
            class="segmented__input"
            type="radio"
            id={id}
            name={name}
            value={option.value}
            data-value={option.value}
            checked={option.value === selected}
          />
          <label class="segmented__label" for={id}>
            <span>{option.label}</span>
            {typeof option.count === 'number' && (
              <span class="segmented__count" aria-label={`${option.count}`}>
                {option.count}
              </span>
            )}
          </label>
        </div>
      );
    })}
  </div>
</fieldset>

<style>
  .segmented {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: inline-block;
    max-width: 100%;
  }
  .segmented--full {
    display: block;
  }
  .segmented__legend {
    padding: 0;
    margin-block-end: var(--space-2);
    font-size: var(--text-subheadline);
    font-weight: 600;
    color: var(--label-secondary);
  }
  .segmented__track {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    max-width: 100%;
    background: var(--fill);
    border-radius: var(--radius-capsule);
  }
  .segmented--full .segmented__track {
    display: flex;
  }
  .segmented__item {
    position: relative;
    flex: 1 1 auto;
    display: flex;
  }
  .segmented__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .segmented__label {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: 2.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-capsule);
    font-size: var(--text-subheadline);
    font-weight: 500;
    line-height: 1.2;
    color: var(--label);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .segmented--sm .segmented__label {
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    font-size: var(--text-footnote);
  }
  .segmented__count {
    font-size: 0.85em;
    color: var(--label-secondary);
    font-variant-numeric: tabular-nums;
  }
  .segmented__input:hover + .segmented__label {
    background: var(--fill);
  }
  .segmented__input:checked + .segmented__label {
    background: var(--bg-elevated);
    color: var(--label);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }
  .segmented__input:checked + .segmented__label .segmented__count {
    color: var(--label);
  }
  .segmented__input:focus-visible + .segmented__label {
    outline: 3px solid var(--focus-ring);
    outline-offset: 1px;
  }
  @media (pointer: coarse) {
    .segmented__label {
      min-height: var(--touch-target);
    }
  }
</style>
