---
/**
 * Section: a full-bleed band with vertical rhythm and an optional alternating background.
 * Wraps its content in a Container unless `container="none"`.
 */
import type { HTMLTag, Polymorphic } from 'astro/types';
import Container from './Container.astro';

type Props<Tag extends HTMLTag = 'section'> = Polymorphic<{ as: Tag }> & {
  /**
   * `secondary` gives the alternating --bg-secondary background; `brand` the navy-to-teal
   * gradient with the `.surface-brand` token mapping (white text, white buttons).
   */
  tone?: 'default' | 'secondary' | 'accent' | 'brand';
  spacing?: 'default' | 'compact' | 'none';
  container?: 'default' | 'narrow' | 'wide' | 'none';
  class?: string;
};

const {
  as: Tag = 'section',
  tone = 'default',
  spacing = 'default',
  container = 'default',
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    'section',
    `section--${tone}`,
    `section--${spacing}`,
    { 'surface-brand': tone === 'brand' },
    className,
  ]}
  {...rest}
>
  {container === 'none' ? (
    <slot />
  ) : (
    <Container width={container}>
      <slot />
    </Container>
  )}
</Tag>

<style>
  .section {
    padding-block: var(--section-padding);
  }
  .section--compact {
    padding-block: var(--space-7);
  }
  .section--none {
    padding-block: 0;
  }
  .section--default {
    background: var(--bg);
  }
  .section--secondary {
    background: var(--bg-secondary);
  }
  .section--accent {
    background: var(--accent-fill);
    color: var(--on-accent);
  }
  .section--brand {
    background: var(--brand-navy);
    background-image: var(--brand-gradient);
  }
  .section--accent :global(h1),
  .section--accent :global(h2),
  .section--accent :global(h3),
  .section--accent :global(p),
  .section--brand :global(h1),
  .section--brand :global(h2),
  .section--brand :global(h3),
  .section--brand :global(p) {
    color: inherit;
  }
</style>
