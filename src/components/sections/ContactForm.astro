---
/**
 * ContactForm: static HTML that posts to the configured endpoint. Netlify Forms attributes are
 * added only when `site.form.provider === 'netlify'`. Phase 5 adds fetch-based submission and
 * state handling through the hooks: `[data-contact-form]`, `[data-form-success]`,
 * `[data-form-error]`, `[data-form-submit]`.
 *
 * Fields: name, email, optional phone, message, required privacy consent (label links to the
 * privacy policy) and a `company` honeypot hidden from people.
 */
import { site } from '../../config/site';
import { getRoute, useTranslations, type Locale } from '../../i18n';
import Button from '../ui/Button.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isNetlify = site.form.provider === 'netlify';
const netlifyAttrs = isNetlify ? { 'data-netlify': 'true', 'netlify-honeypot': 'company' } : {};
const privacyHref = getRoute(lang, 'privacy');
const [consentBefore, consentAfter] = t('form.consent').split('{privacyLink}');
const required = `<span aria-hidden="true">*</span><span class="visually-hidden"> (${t('form.requiredMark')})</span>`;
---

<form
  class="contact-form"
  method="POST"
  action={site.form.endpoint}
  name="contact"
  data-contact-form
  data-provider={site.form.provider}
  {...netlifyAttrs}
>
  {isNetlify && <input type="hidden" name="form-name" value="contact" />}
  <input type="hidden" name="lang" value={lang} />

  <p class="contact-form__note">{t('form.requiredNote')}</p>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-name">
      {t('form.name')} <Fragment set:html={required} />
    </label>
    <input
      class="contact-form__input"
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      aria-describedby="contact-name-hint"
    />
    <p class="contact-form__hint" id="contact-name-hint">{t('form.nameHint')}</p>
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-email">
      {t('form.email')} <Fragment set:html={required} />
    </label>
    <input
      class="contact-form__input"
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      aria-describedby="contact-email-hint"
    />
    <p class="contact-form__hint" id="contact-email-hint">{t('form.emailHint')}</p>
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-phone">
      {t('form.phone')} <span class="contact-form__optional">({t('form.optional')})</span>
    </label>
    <input
      class="contact-form__input"
      id="contact-phone"
      name="phone"
      type="tel"
      autocomplete="tel"
      inputmode="tel"
      aria-describedby="contact-phone-hint"
    />
    <p class="contact-form__hint" id="contact-phone-hint">{t('form.phoneHint')}</p>
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-message">
      {t('form.message')} <Fragment set:html={required} />
    </label>
    <textarea
      class="contact-form__input contact-form__textarea"
      id="contact-message"
      name="message"
      rows="6"
      required
      aria-describedby="contact-message-hint"></textarea>
    <p class="contact-form__hint" id="contact-message-hint">{t('form.messageHint')}</p>
  </div>

  <div class="contact-form__field contact-form__field--check">
    <input class="contact-form__checkbox" id="contact-consent" name="consent" type="checkbox" required />
    <label class="contact-form__label contact-form__label--check" for="contact-consent">
      {consentBefore}<a href={privacyHref}>{t('form.consentLinkLabel')}</a>{consentAfter}
      <Fragment set:html={required} />
    </label>
  </div>

  <!-- Honeypot: hidden from people, ignored by assistive technology, filled only by bots. -->
  <div class="contact-form__trap" aria-hidden="true">
    <label for="contact-company">{t('form.honeypot')}</label>
    <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="contact-form__actions">
    <Button type="submit" size="lg" icon="send" data-form-submit>
      {t('form.submit')}
    </Button>
  </div>

  <p class="contact-form__status contact-form__status--success" role="status" data-form-success hidden>
    {t('form.success')}
  </p>
  <p class="contact-form__status contact-form__status--error" role="alert" data-form-error hidden>
    {t('form.error')}
  </p>
</form>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-5);
    max-width: 36rem;
  }
  .contact-form__note {
    font-size: var(--text-footnote);
    line-height: var(--leading-footnote);
    color: var(--label-secondary);
  }
  .contact-form__field {
    display: grid;
    gap: var(--space-2);
  }
  .contact-form__label {
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    font-weight: 600;
  }
  .contact-form__optional {
    font-weight: 400;
    color: var(--label-secondary);
  }
  .contact-form__input {
    width: 100%;
    min-height: var(--touch-target);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--separator);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    color: var(--label);
    font-size: var(--text-body);
    line-height: 1.3;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .contact-form__input:hover {
    border-color: var(--label-secondary);
  }
  .contact-form__input:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
    border-color: var(--accent);
  }
  .contact-form__textarea {
    resize: vertical;
    min-height: 9rem;
    line-height: var(--leading-body);
  }
  .contact-form__hint {
    font-size: var(--text-footnote);
    line-height: var(--leading-footnote);
    color: var(--label-secondary);
  }
  .contact-form__field--check {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-3);
  }
  .contact-form__checkbox {
    width: 1.5rem;
    height: 1.5rem;
    margin-block-start: 0.1rem;
    accent-color: var(--accent-fill);
    cursor: pointer;
  }
  .contact-form__label--check {
    font-weight: 400;
    font-size: var(--text-callout);
    line-height: var(--leading-body);
    min-height: var(--touch-target);
    display: block;
  }
  .contact-form__trap {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .contact-form__status {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    font-size: var(--text-callout);
    line-height: var(--leading-body);
  }
  .contact-form__status[hidden] {
    display: none;
  }
  .contact-form__status--success {
    background: var(--success-tint);
    color: var(--success-strong);
  }
  .contact-form__status--error {
    background: var(--danger-tint);
    color: var(--danger-strong);
  }
</style>
