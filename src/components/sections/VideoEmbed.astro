---
/**
 * VideoEmbed: a YouTube video behind a click-to-play poster. Nothing loads from YouTube until
 * the visitor presses play; the poster is then swapped for a youtube-nocookie.com iframe that
 * starts playing. Without JavaScript (or with a modified click) the poster is a plain link to
 * the video on YouTube. The cookie policy mentions this embed.
 *
 * The poster is `src/assets/video/<youtubeId>.jpg` when that file exists (download
 * https://i.ytimg.com/vi/<youtubeId>/maxresdefault.jpg); otherwise a brand-coloured poster.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../../i18n';
import Button from '../ui/Button.astro';

interface Props {
  lang: Locale;
  /** The 11-character id after "v=" in the YouTube link. */
  id: string;
  /** The video's title: the iframe title, the play button's label and the caption. */
  title: string;
  class?: string;
}

const { lang, id, title, class: className } = Astro.props;
const t = useTranslations(lang);

const posters = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/video/*.{jpg,jpeg,png,webp}',
  {
    eager: true,
  },
);
const poster = Object.entries(posters).find(
  ([path]) =>
    path
      .split('/')
      .pop()
      ?.replace(/\.[a-z]+$/i, '') === id,
)?.[1].default;

const watchUrl = `https://www.youtube.com/watch?v=${id}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&hl=${lang}`;
---

<figure class:list={['video-embed', className]}>
  <div class="video-embed__frame">
    <a
      class="video-embed__poster"
      href={watchUrl}
      data-video-play
      data-embed-src={embedUrl}
      data-embed-title={title}
      aria-label={t('video.play', { title })}
    >
      {poster ? (
        <Image
          src={poster}
          alt=""
          widths={[640, 960, 1280]}
          sizes="(min-width: 75em) 64rem, calc(100vw - 2rem)"
          class="video-embed__image"
        />
      ) : (
        <span class="video-embed__placeholder" />
      )}
      <span class="video-embed__button" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="32" height="32" focusable="false">
          <path d="M8 5.5v13a1 1 0 0 0 1.53.85l10.4-6.5a1 1 0 0 0 0-1.7L9.53 4.65A1 1 0 0 0 8 5.5Z" />
        </svg>
      </span>
    </a>
  </div>
  <figcaption class="video-embed__caption">
    <span class="video-embed__text">
      <span class="video-embed__title">{title}</span>
      <span class="video-embed__note">{t('video.consentNote')}</span>
    </span>
    <Button
      href={watchUrl}
      variant="plain"
      size="sm"
      newTabLabel={t('a11y.newTab')}
      class="video-embed__link"
    >
      {t('video.watchOnYouTube')}
    </Button>
  </figcaption>
</figure>

<script>
  /* Swap the poster for the player on a plain click; modified clicks still open YouTube. */
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-video-play]')) {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }
      const src = link.dataset.embedSrc;
      if (!src) return;
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.className = 'video-embed__iframe';
      iframe.src = src;
      iframe.title = link.dataset.embedTitle ?? '';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      link.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .video-embed {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .video-embed__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    background: var(--brand-navy);
    box-shadow: var(--shadow-md);
  }
  .video-embed__poster,
  .video-embed__frame :global(.video-embed__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
  }
  .video-embed__poster {
    display: block;
    overflow: hidden;
    color: #ffffff;
  }
  .video-embed__image,
  .video-embed__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .video-embed__placeholder {
    background: var(--brand-gradient);
  }
  /* A navy disc with a white ring: at least 3:1 against any part of the poster. */
  .video-embed__button {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: rgba(11, 34, 66, 0.88);
    box-shadow:
      0 0 0 3px #ffffff,
      var(--shadow-lg);
    transform: translate(-50%, -50%);
    transition:
      transform var(--duration-base) var(--ease-spring),
      background-color var(--duration-fast) var(--ease-out);
  }
  .video-embed__button svg {
    fill: currentColor;
    margin-inline-start: 0.2rem;
  }
  .video-embed__poster:hover .video-embed__button,
  .video-embed__poster:focus-visible .video-embed__button {
    background: var(--brand-teal);
    transform: translate(-50%, -50%) scale(1.08);
  }
  .video-embed__poster:hover .video-embed__image {
    transform: scale(1.02);
  }
  @media (prefers-reduced-motion: reduce) {
    .video-embed__image,
    .video-embed__button {
      transition: none;
    }
    .video-embed__poster:hover .video-embed__image {
      transform: none;
    }
    .video-embed__poster:hover .video-embed__button,
    .video-embed__poster:focus-visible .video-embed__button {
      transform: translate(-50%, -50%);
    }
  }
  .video-embed__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }
  .video-embed__text {
    display: grid;
    gap: var(--space-1);
  }
  .video-embed__title {
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    font-weight: 600;
    color: var(--label);
  }
  .video-embed__note {
    font-size: var(--text-footnote);
    line-height: var(--leading-footnote);
    color: var(--label-secondary);
  }
  .video-embed__caption :global(.video-embed__link) {
    margin-inline-end: calc(-1 * var(--space-3));
  }
</style>
