---
/**
 * ServiceCard: name, duration, price (Intl, RON), package details with the per-session price,
 * the factual description and a "Programează-te" BookingLink that preselects this service in
 * the WhatsApp chat (and prefills the service's own message without JavaScript).
 *
 * `compact` is the home-page teaser: name, duration, "price from" and a link to the service on
 * the services page instead of the description and the booking button.
 */
import type { CollectionEntry } from 'astro:content';
import { formatPrice, getRoute, useTranslations, type Locale } from '../../i18n';
import { serviceAnchor } from '../../lib/content';
import BookingLink from '../BookingLink.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: Locale;
  entry: CollectionEntry<'services'>;
  /** Teaser: duration, "price from" and a details link; no description or booking button. */
  compact?: boolean;
  headingLevel?: 'h3' | 'h4';
}

const { lang, entry, compact = false, headingLevel: Heading = 'h3' } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const price = formatPrice(lang, d.price, d.currency);
const perSession =
  d.sessionsPerPackage && d.sessionsPerPackage > 1
    ? formatPrice(lang, Math.round((d.price / d.sessionsPerPackage) * 100) / 100, d.currency)
    : null;
const detailsHref = `${getRoute(lang, 'services')}#${serviceAnchor(entry)}`;
---

<Card
  as="article"
  variant="elevated"
  class={d.highlighted ? 'service service--highlighted' : 'service'}
  data-service={d.translationKey}
>
  <div class="service__head">
    {d.highlighted && (
      <Badge tone="accent" icon="sparkles">
        {t('pricing.recommended')}
      </Badge>
    )}
    <Heading class="service__name">{d.name}</Heading>
  </div>
  <p class="service__price">
    {compact ? (
      <span class="service__amount service__amount--from">{t('pricing.from', { price })}</span>
    ) : (
      <span class="service__amount">{price}</span>
    )}
    {!compact && perSession && (
      <span class="service__per">{t('pricing.perSession', { price: perSession })}</span>
    )}
  </p>
  <ul class="service__facts" role="list">
    <li>
      <Icon name="clock" size={16} />
      <span>
        {d.sessionsPerPackage
          ? t('pricing.perSessionDuration', { minutes: d.durationMinutes })
          : t('common.duration', { minutes: d.durationMinutes })}
      </span>
    </li>
    {d.sessionsPerPackage && (
      <li>
        <Icon name="calendar-check" size={16} />
        <span>{t('pricing.package', { count: d.sessionsPerPackage })}</span>
      </li>
    )}
  </ul>
  {!compact && <p class="service__desc">{d.description}</p>}
  <div slot="footer" class="service__footer">
    {compact ? (
      <Button href={detailsHref} variant="plain" icon="arrow-right" class="service__details">
        {t('actions.details')}
      </Button>
    ) : (
      <BookingLink
        lang={lang}
        service={d.name}
        message={d.whatsappMessage}
        variant={d.highlighted ? 'primary' : 'secondary'}
        icon="whatsapp"
        iconPosition="start"
        fullWidth
      >
        {t('actions.bookShort')}
      </BookingLink>
    )}
  </div>
</Card>

<style>
  .service--highlighted {
    box-shadow:
      var(--shadow-sm),
      inset 0 0 0 2px var(--accent);
  }
  .service__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .service__name {
    font-size: var(--text-title-3);
    line-height: var(--leading-title-3);
  }
  .service__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
  .service__amount {
    font-size: var(--text-title-1);
    line-height: var(--leading-title-1);
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .service__amount--from {
    font-size: var(--text-title-2);
    line-height: var(--leading-title-2);
  }
  .service__per {
    font-size: var(--text-subheadline);
    color: var(--label-secondary);
  }
  .service__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    color: var(--label-secondary);
  }
  .service__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .service__desc {
    font-size: var(--text-callout);
    line-height: var(--leading-body);
  }
  .service__details {
    margin-inline-start: calc(-1 * var(--space-3));
  }
  /* The full-width booking label wraps instead of overflowing in narrow cards. */
  .service__footer :global(.btn) {
    white-space: normal;
  }
</style>
