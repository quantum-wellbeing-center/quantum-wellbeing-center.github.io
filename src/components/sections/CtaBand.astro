---
/**
 * CtaBand: a centred call-to-action band with a heading, a line of text, a BookingLink (the
 * WhatsApp chat) and, next to it, the `tel:` link from site config or a custom secondary link.
 * The brand gradient band (navy to teal, white text, white buttons through `.surface-brand`)
 * by default; `tone="secondary"` for the subtle tinted band, `tone="accent"` for a flat fill.
 */
import { site, type ChatTopic } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n';
import BookingLink from '../BookingLink.astro';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  heading: string;
  text: string;
  /** Chip preselected in the chat. Defaults to 'booking'. */
  topic?: ChatTopic;
  /** Label of the BookingLink; defaults to "Programează-te pe WhatsApp". */
  bookingLabel?: string;
  /** Custom secondary link; by default the band shows the `tel:` link. */
  secondary?: { href: string; label: string };
  tone?: 'default' | 'secondary' | 'accent' | 'brand';
  id?: string;
}

const {
  lang,
  heading,
  text,
  topic = 'booking',
  bookingLabel,
  secondary,
  tone = 'brand',
  id = 'cta',
} = Astro.props;
const t = useTranslations(lang);
/* On the brand band the primary button is white (via `.surface-brand`), so the pair stays
   primary + secondary; on the flat accent fill a tinted capsule would vanish, so the booking
   button becomes secondary and the phone link plain. */
const secondaryVariant = tone === 'accent' ? 'plain' : 'secondary';
---

<Section tone={tone} class="cta-band" id={id} aria-labelledby={`${id}-heading`}>
  <div class="cta-band__inner">
    <h2 id={`${id}-heading`} class="cta-band__title">
      {heading}
    </h2>
    <p class="cta-band__text">{text}</p>
    <div class="cta-band__actions">
      <BookingLink
        lang={lang}
        topic={topic}
        size="lg"
        variant={tone === 'accent' ? 'secondary' : 'primary'}
        icon="whatsapp"
        iconPosition="start"
      >
        {bookingLabel ?? t('actions.bookWhatsApp')}
      </BookingLink>
      {secondary ? (
        <Button href={secondary.href} variant={secondaryVariant} size="lg">
          {secondary.label}
        </Button>
      ) : (
        <Button
          href={`tel:${site.phoneHref}`}
          variant={secondaryVariant}
          size="lg"
          icon="phone"
          iconPosition="start"
          class="cta-band__phone"
        >
          {t('actions.callNumber', { phone: site.phone })}
        </Button>
      )}
    </div>
  </div>
</Section>

<style>
  .cta-band__inner {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }
  .cta-band__title {
    font-size: var(--text-title-1);
    line-height: var(--leading-title-1);
  }
  .cta-band__text {
    color: var(--label-secondary);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }
  /* Long labels wrap instead of overflowing at 320px. */
  .cta-band__actions :global(.btn) {
    white-space: normal;
    max-width: 100%;
  }
  .cta-band__phone {
    font-variant-numeric: tabular-nums;
  }
</style>
