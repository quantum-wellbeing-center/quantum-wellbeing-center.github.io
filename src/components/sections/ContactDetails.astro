---
/**
 * ContactDetails: one row per channel, an icon and the value, all from site config: email
 * (mailto:), phone (tel:), the address (a link to Google Maps in a new tab, `data-map-link`)
 * and the grouped opening hours. Each row's label is visually hidden and read by screen
 * readers. The WhatsApp trigger is a BookingLink placed by the contact page, not repeated here.
 */
import { site } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n';
import OpeningHours from '../OpeningHours.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const addressLine = `${site.address.street}, ${site.address.postalCode} ${site.address.city}, ${t('contact.county', { county: site.address.county })}`;
---

<dl class="contact-details">
  {
    site.email && (
      <div class="contact-details__row">
        <dt>
          <Icon name="mail" size={24} />
          <span class="visually-hidden">{t('contact.email')}</span>
        </dt>
        <dd>
          <a class="contact-details__link" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </dd>
      </div>
    )
  }
  <div class="contact-details__row">
    <dt>
      <Icon name="phone" size={24} />
      <span class="visually-hidden">{t('contact.phone')}</span>
    </dt>
    <dd>
      <a class="contact-details__link contact-details__link--phone" href={`tel:${site.phoneHref}`}>
        {site.phone}
      </a>
    </dd>
  </div>
  <div class="contact-details__row">
    <dt>
      <Icon name="map-pin" size={24} />
      <span class="visually-hidden">{t('contact.address')}</span>
    </dt>
    <dd>
      <address>
        <a
          class="contact-details__link"
          href={site.mapUrl}
          target="_blank"
          rel="noopener"
          data-map-link
        >
          {addressLine}
          <span class="visually-hidden">({t('a11y.newTab')})</span>
        </a>
      </address>
    </dd>
  </div>
  <div class="contact-details__row contact-details__row--hours">
    <dt>
      <Icon name="clock" size={24} />
      <span class="visually-hidden">{t('contact.hours')}</span>
    </dt>
    <dd>
      <OpeningHours lang={lang} class="contact-details__hours" />
    </dd>
  </div>
</dl>

<style>
  .contact-details {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }
  .contact-details__row {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-4);
  }
  .contact-details__row--hours {
    align-items: start;
  }
  .contact-details dt {
    display: inline-flex;
    color: var(--label);
  }
  .contact-details dd {
    margin: 0;
  }
  .contact-details address {
    font-style: normal;
  }
  .contact-details__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--accent);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact-details__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-details__link--phone {
    font-variant-numeric: tabular-nums;
  }
  .contact-details__hours {
    max-width: 22rem;
    padding-block-start: 0.125rem;
  }
</style>
