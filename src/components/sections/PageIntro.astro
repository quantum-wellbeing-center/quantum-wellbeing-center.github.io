---
/**
 * PageIntro: the h1 band at the top of every non-home page, with an optional lead paragraph.
 * Extra content (a meta line, a note, actions) goes in the default slot under the lead.
 *
 * The band is the brand navy with the `.surface-brand` token mapping (white title, cyan eyebrow
 * and links, white buttons), the same surface as the home hero, so every page opens in the
 * brand colours. Slot content keeps using the semantic tokens and is re-mapped with them.
 */
import Section from '../ui/Section.astro';

interface Props {
  title: string;
  lead?: string;
  /** Small label above the title, e.g. "Eroare 404". */
  eyebrow?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { title, lead, eyebrow, align = 'start', class: className } = Astro.props;
---

<Section
  spacing="compact"
  class={['page-intro', 'surface-brand', className].filter(Boolean).join(' ')}
>
  <div class:list={['page-intro__inner', `page-intro__inner--${align}`]}>
    {eyebrow && <p class="page-intro__eyebrow">{eyebrow}</p>}
    <h1 class="page-intro__title">{title}</h1>
    {lead && <p class="page-intro__lead">{lead}</p>}
    <slot />
  </div>
</Section>

<style>
  /* `.section.page-intro` outranks Section's own tone background and padding rules. */
  .section.page-intro {
    background: var(--brand-navy);
    padding-block: clamp(var(--space-6), 6vw, var(--space-8));
  }
  .page-intro__inner {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .page-intro__inner--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  .page-intro__eyebrow {
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    font-weight: 600;
    color: var(--accent);
  }
  .page-intro__title {
    font-size: clamp(var(--text-large-title), 4.5vw, 3rem);
    line-height: 1.1;
    color: var(--label);
  }
  .page-intro__lead {
    font-size: var(--text-title-3);
    line-height: 1.4;
    font-weight: 400;
    color: var(--label-secondary);
  }
</style>
