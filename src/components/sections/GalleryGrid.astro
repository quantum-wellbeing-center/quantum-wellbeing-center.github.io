---
/**
 * GalleryGrid: the photos of the centre, each shown whole (never cropped), in balanced columns.
 * No captions, no links, no zoom or hover effect: just the pictures. Images are only resized.
 * The home page shows the `featured` entries in one scrollable row, through GalleryStrip.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'gallery'>[];
}

const { entries } = Astro.props;
---

<ul class="gallery" role="list" data-gallery>
  {entries.map((entry) => (
    <li class="gallery__item">
      <Image
        src={entry.data.image}
        alt={entry.data.alt}
        widths={[400, 640, 960, 1280]}
        sizes="(min-width: 64em) 24rem, (min-width: 40em) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        class="gallery__image"
      />
    </li>
  ))}
</ul>

<style>
  .gallery {
    columns: 1;
    column-gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 40em) {
    .gallery {
      columns: 2;
    }
  }
  @media (min-width: 64em) {
    .gallery {
      columns: 3;
    }
  }
  .gallery__item {
    break-inside: avoid;
    margin-block-end: var(--space-4);
  }
  .gallery__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    background: var(--bg-secondary);
  }
</style>
