---
/**
 * GalleryGrid: thumbnails that link to the full image, so the gallery works without JS.
 * Phase 5 upgrades the links into a `dialog` lightbox through the data attributes:
 * `[data-gallery]` on the list, `[data-gallery-item]` (with index, full src, alt and caption)
 * on each link. Images are never edited here: `Image` only resizes.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  entries: CollectionEntry<'gallery'>[];
}

const { lang, entries } = Astro.props;
const t = useTranslations(lang);
---

<ul class="gallery" role="list" data-gallery>
  {entries.map((entry, index) => (
    <li class="gallery__item">
      <figure class="gallery__figure">
        <a
          class="gallery__link"
          href={entry.data.image.src}
          data-gallery-item
          data-gallery-index={index}
          data-gallery-full={entry.data.image.src}
          data-gallery-width={entry.data.image.width}
          data-gallery-height={entry.data.image.height}
          data-gallery-alt={entry.data.alt}
          data-gallery-caption={entry.data.caption}
          aria-label={`${t('actions.openImage')}: ${entry.data.alt}`}
        >
          <Image
            src={entry.data.image}
            alt={entry.data.alt}
            width={600}
            height={400}
            loading="lazy"
            decoding="async"
            class="gallery__image"
          />
        </a>
        <figcaption class="gallery__caption">{entry.data.caption}</figcaption>
      </figure>
    </li>
  ))}
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5) var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .gallery__figure {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .gallery__link {
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-secondary);
    box-shadow: inset 0 0 0 1px var(--separator);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .gallery__link:hover {
    transform: translateY(-2px);
  }
  .gallery__link:focus-visible {
    border-radius: var(--radius-card);
  }
  .gallery__image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .gallery__caption {
    font-size: var(--text-footnote);
    line-height: var(--leading-footnote);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__link:hover {
      transform: none;
    }
  }
</style>
