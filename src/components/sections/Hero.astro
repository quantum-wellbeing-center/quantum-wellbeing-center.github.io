---
/**
 * Hero: the "Centru de wellness" eyebrow, display headline, subheading, the
 * "Programează-te pe WhatsApp" BookingLink and a secondary link, over the brand banner
 * (src/assets/photos/banner.jpg) as a full-bleed background.
 *
 * The banner is decorative (`alt=""`): the brand name is in the header. Its logo sits in the
 * middle third of the image, so the layout keeps the copy out of its way:
 *
 *   - below 80em the copy sits under a clear band (`--hero-band`) that shows the logo, with the
 *     image cover-fitted and anchored to the top, centred on the logo (object-position 51% 0);
 *   - from 80em the copy takes the left 34rem of the container and the image keeps its own
 *     aspect ratio, as tall as the hero and anchored to the right edge, so the logo lands right
 *     of the copy (its left arc may touch the copy between 80em and ~84em). On very wide
 *     screens the space left of the image is the brand navy, feathered into the image.
 *
 * Contrast (tests/contrast.mjs, "hero scrim" rows): the scrim is `--brand-navy` at 90% behind
 * the copy, and the worst case is white text over that scrim composited on a pure white pixel
 * (the banner's particle highlights reach #ffffff). White on that surface is 11.88:1, the
 * `--label-secondary` lead 8.31:1 and the cyan eyebrow 8.26:1; the band above the copy fades
 * through 30%, where the headline never sits. Both colour schemes use the same values: the
 * surface is always dark (`.surface-brand`).
 */
import { Picture } from 'astro:assets';
import type { Locale } from '../../i18n';
import banner from '../../assets/photos/banner.jpg';
import BookingLink from '../BookingLink.astro';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  eyebrow: string;
  headline: string;
  subheading: string;
  /** Label of the BookingLink. */
  bookingLabel: string;
  secondary?: { href: string; label: string };
  id?: string;
}

const { lang, eyebrow, headline, subheading, bookingLabel, secondary, id = 'hero' } = Astro.props;
---

<Section class="hero surface-brand" spacing="none" id={id} aria-labelledby={`${id}-title`}>
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={banner}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, banner.width]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      pictureAttributes={{ class: 'hero__picture' }}
      class="hero__image"
    />
  </div>
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{eyebrow}</p>
      <h1 id={`${id}-title`} class="hero__title text-display">
        {headline}
      </h1>
      <p class="hero__lead">{subheading}</p>
      <div class="hero__actions">
        <BookingLink lang={lang} size="lg" icon="whatsapp" iconPosition="start">
          {bookingLabel}
        </BookingLink>
        {secondary && (
          <Button href={secondary.href} variant="secondary" size="lg" icon="arrow-right">
            {secondary.label}
          </Button>
        )}
      </div>
    </div>
  </div>
</Section>

<style>
  /* `.section.hero` outranks Section's own `.section--none` padding rule. */
  .section.hero {
    /* Clear band above the copy on small screens: enough of the image to show the logo. */
    --hero-band: clamp(13rem, 60vw, 24rem);
    --hero-copy-width: 34rem;
    --hero-scrim-strong: color-mix(in srgb, var(--brand-navy) 90%, transparent);
    --hero-scrim-mid: color-mix(in srgb, var(--brand-navy) 30%, transparent);
    --hero-scrim-weak: color-mix(in srgb, var(--brand-navy) 12%, transparent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--brand-navy);
    padding-block: var(--hero-band) var(--space-7);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(.hero__picture) {
    position: absolute;
    inset: 0;
  }
  .hero__media :global(.hero__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Centred on the logo, anchored to the top so the clear band shows it. */
    object-position: 51% 0;
  }
  /* The scrim: light over the band, strong from just above the copy down. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--hero-scrim-weak) 0,
      var(--hero-scrim-mid) calc(var(--hero-band) - 7rem),
      var(--hero-scrim-strong) calc(var(--hero-band) - 1rem),
      var(--hero-scrim-strong) 100%
    );
  }
  .hero__inner {
    display: grid;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: var(--hero-copy-width);
  }
  .hero__eyebrow {
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero__title {
    /* A notch under `.text-display`: on wide screens the headline must hold two lines inside
       the 34rem copy column, or the hero grows and the right-anchored image slides under it. */
    font-size: clamp(2.5rem, 4.2vw, 4rem);
    max-width: 14ch;
    text-wrap: balance;
    color: var(--label);
  }
  .hero__lead {
    font-size: var(--text-title-3);
    line-height: 1.4;
    font-weight: 400;
    color: var(--label-secondary);
    max-width: 48ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  /* Long verb-led labels ("Programează-te pe WhatsApp") wrap instead of overflowing at 320px. */
  .hero__actions :global(.btn) {
    white-space: normal;
    max-width: 100%;
  }
  @media (min-width: 80em) {
    .section.hero {
      /* Right edge of the copy column, measured from the hero's left edge. */
      --hero-copy-edge: calc(
        max(0px, (100cqw - var(--container)) / 2) + var(--space-6) + var(--hero-copy-width)
      );
      --hero-banner-ratio: 1553 / 775;
      /* Kept short enough that the image, placed from the copy edge, still shows the red mark
         on its right (90% of its width) inside the viewport from 1280px up. */
      min-height: min(36vw, 44rem);
      padding-block: clamp(3rem, 5vw, 6rem);
      display: grid;
      align-items: center;
    }
    /* A size container, so the image can be placed from the hero's own height (cqh). */
    .hero__media {
      container-type: size;
    }
    .hero__media :global(.hero__image) {
      /* Own aspect ratio, as tall as the hero, placed so the wordmark's left edge (29% of the
         banner's width) starts 2rem right of the copy column. Only the empty right margin of the
         banner is cropped on narrower screens; the wordmark and logo never sit under the copy. */
      left: calc(var(--hero-copy-edge) + var(--space-6) - 0.29 * 100cqh * var(--hero-banner-ratio));
      right: auto;
      width: auto;
      max-width: none;
      aspect-ratio: var(--hero-banner-ratio);
      position: absolute;
      /* Feather both edges into the navy that fills the rest on very wide screens. */
      mask-image: linear-gradient(to right, transparent, #000 22%, #000 92%, transparent);
    }
    .hero__media::after {
      background: linear-gradient(
        to right,
        var(--hero-scrim-strong) 0,
        var(--hero-scrim-strong) var(--hero-copy-edge),
        var(--hero-scrim-weak) calc(var(--hero-copy-edge) + var(--space-6)),
        var(--hero-scrim-weak) 100%
      );
    }
  }
</style>
