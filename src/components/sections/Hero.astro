---
/**
 * Hero: the "Centru de wellness" eyebrow, display headline, subheading, the
 * "Programează-te pe WhatsApp" BookingLink, a secondary link and a decorative placeholder
 * visual (concentric rings in the brand accent; no stock photography).
 */
import type { Locale } from '../../i18n';
import BookingLink from '../BookingLink.astro';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  eyebrow: string;
  headline: string;
  subheading: string;
  /** Label of the BookingLink. */
  bookingLabel: string;
  secondary?: { href: string; label: string };
  id?: string;
}

const { lang, eyebrow, headline, subheading, bookingLabel, secondary, id = 'hero' } = Astro.props;
---

<Section class="hero" spacing="compact" id={id} aria-labelledby={`${id}-title`}>
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{eyebrow}</p>
      <h1 id={`${id}-title`} class="hero__title text-display">
        {headline}
      </h1>
      <p class="hero__lead">{subheading}</p>
      <div class="hero__actions">
        <BookingLink lang={lang} size="lg" icon="whatsapp" iconPosition="start">
          {bookingLabel}
        </BookingLink>
        {secondary && (
          <Button href={secondary.href} variant="secondary" size="lg" icon="arrow-right">
            {secondary.label}
          </Button>
        )}
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <svg viewBox="0 0 400 400" width="400" height="400" focusable="false">
        <defs>
          <radialGradient id="hero-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.22"></stop>
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <circle cx="200" cy="200" r="200" fill="url(#hero-glow)"></circle>
        <g fill="none" stroke="var(--accent)" stroke-linecap="round">
          <circle cx="200" cy="200" r="150" stroke-width="1" opacity="0.25"></circle>
          <circle cx="200" cy="200" r="112" stroke-width="1.5" opacity="0.4"></circle>
          <circle cx="200" cy="200" r="74" stroke-width="2" opacity="0.6"></circle>
          <circle cx="200" cy="200" r="36" stroke-width="2.5" opacity="0.85"></circle>
        </g>
        <circle cx="200" cy="200" r="10" fill="var(--accent)"></circle>
      </svg>
    </div>
  </div>
</Section>

<style>
  .hero {
    padding-block: clamp(var(--space-7), 7vw, var(--space-9));
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 38rem;
  }
  .hero__eyebrow {
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero__title {
    max-width: 14ch;
  }
  .hero__lead {
    font-size: var(--text-title-3);
    line-height: 1.4;
    font-weight: 400;
    color: var(--label-secondary);
    max-width: 48ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  /* Long verb-led labels ("Programează-te pe WhatsApp") wrap instead of overflowing at 320px. */
  .hero__actions :global(.btn) {
    white-space: normal;
    max-width: 100%;
  }
  .hero__visual {
    display: none;
    justify-self: center;
  }
  .hero__visual svg {
    width: min(100%, 26rem);
    height: auto;
  }
  @media (min-width: 48em) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
    .hero__visual {
      display: block;
    }
  }
</style>
