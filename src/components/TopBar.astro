---
/**
 * Top info bar: phone, hours, email, socials. Hidden below 900px (the phone moves into the menu).
 */
import { site } from '../config/site';
import { useTranslations, type Locale } from '../i18n';
import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';
import OpeningHours from './OpeningHours.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="topbar">
  <Container>
    <div class="topbar__inner" aria-label={t('a11y.topBar')} role="region">
      <ul class="topbar__list" role="list">
        <li>
          <a class="topbar__link" href={`tel:${site.phoneHref}`}>
            <Icon name="phone" size={16} />
            <span class="visually-hidden">{t('topBar.phone')}: </span>
            <span>{site.phone}</span>
          </a>
        </li>
        <li class="topbar__item">
          <Icon name="clock" size={16} />
          <span class="visually-hidden">{t('topBar.hours')}: </span>
          <OpeningHours lang={lang} inline />
        </li>
        {
          site.email && (
            <li class="topbar__email">
              <a class="topbar__link" href={`mailto:${site.email}`}>
                <Icon name="mail" size={16} />
                <span class="visually-hidden">{t('topBar.email')}: </span>
                <span>{site.email}</span>
              </a>
            </li>
          )
        }
      </ul>
      <SocialLinks lang={lang} size="sm" class="topbar__socials" />
    </div>
  </Container>
</div>

<style>
  .topbar {
    display: none;
    background: var(--bg-secondary);
    color: var(--label-secondary);
    font-size: var(--text-footnote);
    border-bottom: 1px solid var(--separator);
  }
  /* Same breakpoint as the desktop header (MobileMenu.astro). */
  @media (min-width: 72em) {
    .topbar {
      display: block;
    }
  }
  /* Just above 900px the email would push the bar onto two lines; the footer and the contact
     page still show it. */
  @media (max-width: 59.99em) {
    .topbar__email {
      display: none;
    }
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--topbar-height);
  }
  .topbar__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .topbar__item,
  .topbar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--touch-target);
  }
  .topbar__link {
    color: inherit;
    text-decoration: none;
  }
  .topbar__link:hover {
    color: var(--accent);
  }
  .topbar__socials {
    color: var(--label-secondary);
  }
</style>
