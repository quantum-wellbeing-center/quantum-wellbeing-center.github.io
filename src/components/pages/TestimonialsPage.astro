---
/**
 * TestimonialsPage: the consent-gated testimonials grid (or, while there are none, links to
 * testimonials from EESystem centres worldwide), and the gallery of the centre's
 * space and team (whole photos, no captions, no lightbox).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n';
import { canShowGalleryImage, getGallery, getPage, getTestimonials } from '../../lib/content';
import Section from '../ui/Section.astro';
import GalleryGrid from '../sections/GalleryGrid.astro';
import PageIntro from '../sections/PageIntro.astro';
import SectionHeading from '../sections/SectionHeading.astro';
import TestimonialCard from '../sections/TestimonialCard.astro';
import WorldTestimonials from '../sections/WorldTestimonials.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { data: page } = await getPage(lang, 'testimonials');
const [testimonials, gallery] = await Promise.all([getTestimonials(lang), getGallery(lang)]);
// Consent is enforced by the schema and by the queries; filter once more where the content is shown.
const published = testimonials.filter((e) => e.data.consent === true);
const images = gallery.filter(canShowGalleryImage);
---

<BaseLayout lang={lang} pageKey="testimonials" title={page.title} description={page.description}>
  <PageIntro title={page.title} lead={page.subheading} />

  {published.length > 0 ? (
    <Section spacing="compact" class="testimonials-list" aria-label={page.title}>
      <ul class="testimonials-grid" role="list">
        {published.map((entry) => (
          <li>
            <TestimonialCard lang={lang} entry={entry} />
          </li>
        ))}
      </ul>
    </Section>
  ) : (
    <WorldTestimonials lang={lang} id="world-testimonials" />
  )}

  <Section tone="secondary" id="gallery" aria-labelledby="gallery-heading">
    <SectionHeading id="gallery-heading" title={page.gallery.heading} />
    <GalleryGrid entries={images} />
  </Section>
</BaseLayout>

<style>
  .testimonials-list {
    padding-block-end: clamp(var(--space-7), 8vw, var(--space-9));
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .testimonials-grid > li {
    display: flex;
  }
  .testimonials-grid > li > :global(*) {
    width: 100%;
  }
</style>
