---
/**
 * TechnologyPage: the plain-language "how it works" explainer (Markdown body), the reported
 * experiences block, the complementary services and a CTA.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { getRoute, useTranslations, type Locale } from '../../i18n';
import { getPage, getServices } from '../../lib/content';
import Section from '../ui/Section.astro';
import CtaBand from '../sections/CtaBand.astro';
import PageIntro from '../sections/PageIntro.astro';
import ReportedExperiences from '../sections/ReportedExperiences.astro';
import ServicesGrid from '../sections/ServicesGrid.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry, data: page } = await getPage(lang, 'technology');
const { Content } = await render(entry);
const services = await getServices(lang);
---

<BaseLayout lang={lang} pageKey="technology" title={page.title} description={page.description}>
  <PageIntro title={page.title} lead={page.subheading} />

  <Section spacing="compact" class="technology-body">
    <div class="prose technology-prose">
      <Content />
    </div>
  </Section>

  <ReportedExperiences
    heading={page.reports.heading}
    intro={page.reports.intro}
    items={page.reports.items}
    note={page.reports.note}
    tone="secondary"
    id="technology-reports"
  />

  <ServicesGrid
    lang={lang}
    entries={services}
    heading={page.services.heading}
    text={page.services.text}
    action={{ href: getRoute(lang, 'pricing'), label: t('actions.seePricing') }}
    id="technology-services"
  />

  <CtaBand
    lang={lang}
    heading={page.cta.heading}
    text={page.cta.text}
    primary={{ href: site.bookingUrl, label: t('actions.bookSession') }}
    secondary={{ href: getRoute(lang, 'contact'), label: t('actions.contactUs') }}
  />
</BaseLayout>

<style>
  .technology-body {
    padding-block-end: clamp(var(--space-7), 8vw, var(--space-9));
  }
  .technology-prose :global(h2) {
    font-size: var(--text-title-2);
    line-height: var(--leading-title-2);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--separator);
  }
  .technology-prose :global(h2:first-child) {
    border-top: 0;
    padding-block-start: 0;
  }
</style>
