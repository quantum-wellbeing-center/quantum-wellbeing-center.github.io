---
/**
 * HomePage, in order: hero, "Despre centru" (a title and a scrollable row of the featured
 * gallery photos), service cards, "Cum te programezi" in three steps,
 * testimonials row (links to EESystem centres worldwide while there are none), FAQ teaser and the CTA band with the WhatsApp BookingLink and the phone number.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRoute, useTranslations, type Locale } from '../../i18n';
import {
  getFeaturedFaqs,
  getFeaturedGallery,
  getPage,
  getServices,
  getTestimonials,
} from '../../lib/content';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import BookingSteps from '../sections/BookingSteps.astro';
import CtaBand from '../sections/CtaBand.astro';
import FaqAccordion from '../sections/FaqAccordion.astro';
import GalleryStrip from '../sections/GalleryStrip.astro';
import Hero from '../sections/Hero.astro';
import SectionHeading from '../sections/SectionHeading.astro';
import ServicesGrid from '../sections/ServicesGrid.astro';
import TestimonialRow from '../sections/TestimonialRow.astro';
import WorldTestimonials from '../sections/WorldTestimonials.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { data: page } = await getPage(lang, 'home');

const [services, gallery, testimonials, faqs] = await Promise.all([
  getServices(lang),
  getFeaturedGallery(lang),
  getTestimonials(lang),
  getFeaturedFaqs(lang, 5),
]);
const photos = gallery.map((entry) => ({ src: entry.data.image, alt: entry.data.alt }));
---

<BaseLayout lang={lang} pageKey="home" title={page.title} description={page.description}>
  <Hero
    lang={lang}
    eyebrow={page.hero.eyebrow}
    headline={page.hero.headline}
    subheading={page.hero.subheading}
    bookingLabel={t('actions.bookWhatsApp')}
    secondary={{ href: getRoute(lang, 'pricing'), label: t('actions.seePricing') }}
  />

  <Section tone="secondary" id="home-about" aria-labelledby="home-about-heading">
    <GalleryStrip
      lang={lang}
      heading={page.about.heading}
      headingId="home-about-heading"
      photos={photos}
    />
  </Section>

  <ServicesGrid
    lang={lang}
    entries={services}
    heading={page.services.heading}
    text={page.services.text}
    action={{ href: getRoute(lang, 'pricing'), label: t('actions.seePricing') }}
    compact
    id="home-services"
  />

  <BookingSteps
    heading={page.steps.heading}
    text={page.steps.text}
    items={page.steps.items}
    id="home-steps"
    tone="secondary"
  />

  {testimonials.length > 0 ? (
    <Section id="home-testimonials" aria-labelledby="home-testimonials-heading">
      <SectionHeading
        id="home-testimonials-heading"
        title={page.testimonials.heading}
        text={page.testimonials.text}
        action={{ href: getRoute(lang, 'testimonials'), label: t('actions.seeAllTestimonials') }}
      />
      <TestimonialRow lang={lang} entries={testimonials} />
    </Section>
  ) : (
    <WorldTestimonials lang={lang} id="home-testimonials" />
  )}

  <Section tone="secondary" id="home-faq" aria-labelledby="home-faq-heading">
    <div class="home-faq">
      <SectionHeading id="home-faq-heading" title={page.faq.heading} text={page.faq.text} />
      <FaqAccordion entries={faqs} />
      <p class="home-faq__more">
        <Button href={getRoute(lang, 'faq')} variant="plain" icon="arrow-right">
          {t('actions.seeAllFaq')}
        </Button>
      </p>
    </div>
  </Section>

  <CtaBand lang={lang} heading={page.cta.heading} text={page.cta.text} id="home-cta" />
</BaseLayout>

<style>
  .home-faq {
    max-width: 48rem;
  }
  .home-faq__more {
    margin-block-start: var(--space-5);
    margin-inline-start: calc(-1 * var(--space-3));
  }
</style>
