---
/**
 * HomePage: the eight sections of WEBSITE_PLAN.md section 6, in order: hero, factual intro,
 * service cards, "Cum te programezi" in three steps, gallery strip, testimonials row, FAQ
 * teaser and the CTA band with the WhatsApp BookingLink and the phone number.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRoute, useTranslations, type Locale } from '../../i18n';
import {
  getFeaturedFaqs,
  getGallery,
  getPage,
  getServices,
  getTestimonials,
} from '../../lib/content';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import BookingSteps from '../sections/BookingSteps.astro';
import CtaBand from '../sections/CtaBand.astro';
import FaqAccordion from '../sections/FaqAccordion.astro';
import GalleryGrid from '../sections/GalleryGrid.astro';
import Hero from '../sections/Hero.astro';
import SectionHeading from '../sections/SectionHeading.astro';
import ServicesGrid from '../sections/ServicesGrid.astro';
import TestimonialRow from '../sections/TestimonialRow.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry, data: page } = await getPage(lang, 'home');
const { Content } = await render(entry);
const hasBody = Boolean(entry.body && entry.body.trim());

const [services, gallery, testimonials, faqs] = await Promise.all([
  getServices(lang),
  getGallery(lang),
  getTestimonials(lang),
  getFeaturedFaqs(lang, 5),
]);
const galleryHref = `${getRoute(lang, 'testimonials')}#gallery`;
---

<BaseLayout lang={lang} pageKey="home" title={page.title} description={page.description}>
  <Hero
    lang={lang}
    eyebrow={page.hero.eyebrow}
    headline={page.hero.headline}
    subheading={page.hero.subheading}
    bookingLabel={t('actions.bookWhatsApp')}
    secondary={{ href: getRoute(lang, 'services'), label: t('actions.seeServices') }}
  />

  <Section tone="secondary" id="home-intro" aria-labelledby="home-intro-heading">
    <div class="home-intro">
      <h2 id="home-intro-heading">{page.intro.heading}</h2>
      <p class="home-intro__text">{page.intro.text}</p>
      {hasBody && (
        <div class="prose home-intro__body">
          <Content />
        </div>
      )}
    </div>
  </Section>

  <ServicesGrid
    lang={lang}
    entries={services}
    heading={page.services.heading}
    text={page.services.text}
    action={{ href: getRoute(lang, 'services'), label: t('actions.seeServices') }}
    compact
    id="home-services"
  />

  <BookingSteps
    heading={page.steps.heading}
    text={page.steps.text}
    items={page.steps.items}
    id="home-steps"
    tone="secondary"
  />

  <Section id="home-gallery" aria-labelledby="home-gallery-heading">
    <SectionHeading
      id="home-gallery-heading"
      title={page.gallery.heading}
      text={page.gallery.text}
      action={{ href: galleryHref, label: t('actions.seeGallery') }}
    />
    <GalleryGrid lang={lang} entries={gallery} layout="strip" />
  </Section>

  <Section tone="secondary" id="home-testimonials" aria-labelledby="home-testimonials-heading">
    <SectionHeading
      id="home-testimonials-heading"
      title={page.testimonials.heading}
      text={page.testimonials.text}
      action={{ href: getRoute(lang, 'testimonials'), label: t('actions.seeAllTestimonials') }}
    />
    <TestimonialRow lang={lang} entries={testimonials} />
  </Section>

  <Section id="home-faq" aria-labelledby="home-faq-heading">
    <div class="home-faq">
      <SectionHeading id="home-faq-heading" title={page.faq.heading} text={page.faq.text} />
      <FaqAccordion entries={faqs} />
      <p class="home-faq__more">
        <Button href={getRoute(lang, 'faq')} variant="plain" icon="arrow-right">
          {t('actions.seeAllFaq')}
        </Button>
      </p>
    </div>
  </Section>

  <CtaBand lang={lang} heading={page.cta.heading} text={page.cta.text} id="home-cta" />
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: var(--measure);
  }
  .home-intro__text {
    font-size: var(--text-title-3);
    line-height: 1.4;
    font-weight: 400;
    color: var(--label-secondary);
  }
  .home-intro__body {
    color: var(--label-secondary);
  }
  .home-faq {
    max-width: 48rem;
  }
  .home-faq__more {
    margin-block-start: var(--space-5);
    margin-inline-start: calc(-1 * var(--space-3));
  }
</style>
