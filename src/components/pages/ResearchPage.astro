---
/**
 * ResearchPage: a neutral document library. The intro says the documents are listed for
 * information and that some are not peer-reviewed; the items are grouped into sections with
 * counts. No editorial commentary. Everything renders statically; the Phase 5 search and filter
 * island hooks into:
 *   [data-research-controls]           placeholder slot above the groups
 *   [data-research-status]             aria-live region for result counts
 *   [data-research-empty]              hidden empty state
 *   [data-research-group][data-count]  each group section
 *   [data-research-item] + data-title / data-authors / data-document-type / data-group
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESEARCH_GROUPS } from '../../content.config';
import { useTranslations, type Locale } from '../../i18n';
import { getPage, getResearch } from '../../lib/content';
import Section from '../ui/Section.astro';
import PageIntro from '../sections/PageIntro.astro';
import ResearchCard from '../sections/ResearchCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry, data: page } = await getPage(lang, 'research');
const { Content } = await render(entry);
const hasBody = Boolean(entry.body && entry.body.trim());
const items = await getResearch(lang);

const groups = RESEARCH_GROUPS.map((group) => ({
  group,
  ...page.groups[group],
  items: items.filter((item) => item.data.group === group),
})).filter((group) => group.items.length > 0);
const countLabel = (n: number) =>
  n === 1 ? t('research.countOne') : t('research.count', { count: n });
---

<BaseLayout lang={lang} pageKey="research" title={page.title} description={page.description}>
  <PageIntro title={page.title} lead={page.subheading}>
    {hasBody && (
      <div class="prose research-intro">
        <Content />
      </div>
    )}
    <p class="research-total">{countLabel(items.length)}</p>
  </PageIntro>

  <Section class="research-library" spacing="compact">
    <div data-research-controls></div>
    <p class="research-status" aria-live="polite" data-research-status></p>
    <p class="research-empty" data-research-empty hidden>
      {t('common.noResults')}
    </p>

    {groups.map(({ group, heading, text, items: groupItems }) => (
      <section
        class="research-group"
        data-research-group={group}
        data-count={groupItems.length}
        aria-labelledby={`research-${group}-heading`}
      >
        <div class="research-group__head">
          <h2 id={`research-${group}-heading`} class="research-group__title">
            {heading}
            <span class="research-group__count" data-research-group-count>
              {countLabel(groupItems.length)}
            </span>
          </h2>
          <p class="research-group__text">{text}</p>
        </div>
        <ul class="research-group__list" role="list">
          {groupItems.map((item) => (
            <li>
              <ResearchCard lang={lang} entry={item} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </Section>
</BaseLayout>

<style>
  .research-intro {
    color: var(--label-secondary);
  }
  .research-total {
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    font-weight: 500;
    color: var(--label-secondary);
    font-variant-numeric: tabular-nums;
  }
  .research-library {
    padding-block-end: clamp(var(--space-7), 8vw, var(--space-9));
  }
  .research-status:empty,
  .research-empty[hidden] {
    display: none;
  }
  .research-status {
    margin-block-end: var(--space-4);
    font-size: var(--text-subheadline);
    color: var(--label-secondary);
  }
  .research-empty {
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--bg-secondary);
    text-align: center;
    color: var(--label-secondary);
  }
  .research-group + .research-group {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-7);
    border-top: 1px solid var(--separator);
  }
  .research-group[hidden] {
    display: none;
  }
  .research-group__head {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
    margin-block-end: var(--space-5);
  }
  .research-group__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }
  .research-group__count {
    font-size: var(--text-subheadline);
    line-height: var(--leading-subheadline);
    font-weight: 500;
    color: var(--label-secondary);
    font-variant-numeric: tabular-nums;
  }
  .research-group__text {
    color: var(--label-secondary);
  }
  .research-group__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .research-group__list > li {
    display: flex;
  }
  .research-group__list > li > :global(*) {
    width: 100%;
  }
</style>
