---
/**
 * ContactPage: the h1, then two columns. Left: the intro paragraph, the contact rows (email,
 * phone, address linking to Google Maps, hours) and the WhatsApp BookingLink (topic "other").
 * Right: an embedded Google Maps iframe with a pin on the address (`site.mapEmbedUrl`), in the
 * page's language. Google loads the map from its own servers and may set its own cookies; the
 * cookie policy mentions it. There is no contact form.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n';
import { getPage } from '../../lib/content';
import BookingLink from '../BookingLink.astro';
import Section from '../ui/Section.astro';
import ContactDetails from '../sections/ContactDetails.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry, data: page } = await getPage(lang, 'contact');
const { Content } = await render(entry);
const hasBody = Boolean(entry.body && entry.body.trim());
const mapSrc = `${site.mapEmbedUrl}&hl=${lang}`;
---

<BaseLayout lang={lang} pageKey="contact" title={page.title} description={page.description}>
  <PageIntro title={page.title} class="contact-intro" />

  <Section class="contact">
    <div class="contact__grid">
      <div class="contact__info">
        <p class="contact__lead">{page.subheading}</p>
        <ContactDetails lang={lang} />
        <div class="contact__actions">
          <BookingLink lang={lang} topic="other" size="lg" icon="whatsapp" iconPosition="start">
            {t('actions.writeWhatsApp')}
          </BookingLink>
        </div>
        {hasBody && (
          <div class="prose contact__note">
            <Content />
          </div>
        )}
      </div>
      <div class="contact__map">
        <iframe
          class="contact__map-frame"
          src={mapSrc}
          title={t('contact.mapTitle')}
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .contact-intro :global(.page-intro__title) {
    font-size: clamp(var(--text-large-title), 6vw, 4rem);
  }
  .contact {
    padding-block: var(--space-7) clamp(var(--space-7), 8vw, var(--space-9));
  }
  .contact__grid {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 56em) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-8);
      align-items: stretch;
    }
  }
  .contact__info {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .contact__lead {
    max-width: 40ch;
    font-size: var(--text-title-3);
    line-height: 1.5;
    color: var(--label-secondary);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  /* Long labels wrap instead of overflowing at 320px. */
  .contact__actions :global(.btn) {
    white-space: normal;
    max-width: 100%;
  }
  .contact__note {
    color: var(--label-secondary);
    font-size: var(--text-footnote);
    line-height: var(--leading-footnote);
  }
  .contact__map {
    position: relative;
    min-height: 22rem;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-secondary);
    box-shadow:
      inset 0 0 0 1px var(--separator),
      var(--shadow-md);
  }
  @media (min-width: 56em) {
    .contact__map {
      min-height: 30rem;
    }
  }
  .contact__map-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
