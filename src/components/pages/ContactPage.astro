---
/**
 * ContactPage: intro, contact details with hours, a static map placeholder with a link to
 * Google Maps (no iframe), and the contact form.
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n';
import { getPage } from '../../lib/content';
import mapPlaceholder from '../../assets/brand/map-placeholder.svg';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import ContactDetails from '../sections/ContactDetails.astro';
import ContactForm from '../sections/ContactForm.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { entry, data: page } = await getPage(lang, 'contact');
const { Content } = await render(entry);
---

<BaseLayout lang={lang} pageKey="contact" title={page.title} description={page.description}>
  <PageIntro title={page.title} lead={page.subheading}>
    <div class="prose contact-intro">
      <Content />
    </div>
  </PageIntro>

  <Section spacing="compact" class="contact">
    <div class="contact__grid">
      <div class="contact__details" aria-labelledby="contact-details-heading">
        <h2 id="contact-details-heading" class="contact__heading">{page.details.heading}</h2>
        <ContactDetails lang={lang} />
      </div>
      <div class="contact__map" aria-labelledby="contact-map-heading">
        <h2 id="contact-map-heading" class="contact__heading">{page.map.heading}</h2>
        <p class="contact__map-text">{page.map.text}</p>
        <figure class="contact__map-figure">
          <Image
            src={mapPlaceholder}
            alt={t('contact.mapAlt')}
            width={900}
            height={600}
            loading="lazy"
            decoding="async"
            class="contact__map-image"
          />
        </figure>
        <Button
          href={site.mapUrl}
          variant="secondary"
          icon="map-pin"
          iconPosition="start"
          newTabLabel={t('a11y.newTab')}
        >
          {t('actions.openInMaps')}
        </Button>
      </div>
    </div>
  </Section>

  <Section tone="secondary" aria-labelledby="contact-form-heading">
    <div class="contact__form-wrap">
      <div class="contact__form-intro">
        <h2 id="contact-form-heading">{page.form.heading}</h2>
        <p class="contact__form-text">{page.form.text}</p>
      </div>
      <ContactForm lang={lang} />
    </div>
  </Section>
</BaseLayout>

<style>
  .contact-intro {
    color: var(--label-secondary);
  }
  .contact {
    padding-block-end: clamp(var(--space-7), 8vw, var(--space-9));
  }
  .contact__grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  @media (min-width: 56em) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-8);
    }
  }
  .contact__heading {
    font-size: var(--text-title-2);
    line-height: var(--leading-title-2);
    margin-block-end: var(--space-4);
  }
  .contact__map {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .contact__map .contact__heading {
    margin-block-end: 0;
  }
  .contact__map-text {
    color: var(--label-secondary);
  }
  .contact__map-figure {
    width: 100%;
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--separator);
    background: var(--bg-secondary);
  }
  .contact__map-image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .contact__form-wrap {
    display: grid;
    gap: var(--space-6);
    max-width: 36rem;
  }
  .contact__form-intro {
    display: grid;
    gap: var(--space-3);
  }
  .contact__form-text {
    color: var(--label-secondary);
  }
</style>
