---
/**
 * ArticlePage: cover, title, meta (author, dates, reading time, tags), the Markdown body as
 * prose, previous/next links and the back link. Open Graph type is `article` with the cover as
 * image; the language switcher points at the twin article or, without one, at the other home.
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { formatDate, getRoute, useTranslations, type Locale } from '../../i18n';
import {
  articlePath,
  articleSlug,
  getArticleNeighbours,
  getArticleTwinPath,
  readingTimeMinutes,
  type ArticleEntry,
} from '../../lib/content';
import { isoDate } from '../../lib/format';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  entry: ArticleEntry;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const { Content } = await render(entry);
const [twinPath, neighbours] = await Promise.all([
  getArticleTwinPath(entry),
  getArticleNeighbours(entry),
]);
const minutes = readingTimeMinutes(entry.body);
const feedPath = lang === 'ro' ? '/rss.xml' : '/en/rss.xml';
const feedTitle = t('articles.feedTitle', { brand: site.brandName });
const listPath = getRoute(lang, 'articles');
---

<BaseLayout
  lang={lang}
  pageKey="article"
  params={{ slug: articleSlug(entry) }}
  alternateUrl={twinPath}
  title={d.title}
  description={d.description}
  ogType="article"
  ogImage={d.cover.src}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={feedTitle} href={feedPath} />
    <meta property="article:published_time" content={d.publishDate.toISOString()} />
    {d.updatedDate && (
      <meta property="article:modified_time" content={d.updatedDate.toISOString()} />
    )}
    {d.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  <article class="article">
    <Section spacing="compact" container="narrow" class="article__head">
      <p class="article__back">
        <a href={listPath} class="article__back-link">
          <Icon name="chevron-left" size={18} />
          <span>{t('actions.backToArticles')}</span>
        </a>
      </p>
      <h1 class="article__title">{d.title}</h1>
      <p class="article__lead">{d.description}</p>
      <dl class="article__meta">
        <div>
          <dt class="visually-hidden">{t('common.by')}</dt>
          <dd>{d.author}</dd>
        </div>
        <div>
          <dt>{t('common.published')}</dt>
          <dd>
            <time datetime={isoDate(d.publishDate)}>{formatDate(lang, d.publishDate)}</time>
          </dd>
        </div>
        {d.updatedDate && (
          <div>
            <dt>{t('common.updated')}</dt>
            <dd>
              <time datetime={isoDate(d.updatedDate)}>{formatDate(lang, d.updatedDate)}</time>
            </dd>
          </div>
        )}
        <div>
          <dt class="visually-hidden">{t('common.readingTime', { minutes })}</dt>
          <dd aria-hidden="true">{t('common.readingTime', { minutes })}</dd>
        </div>
      </dl>
    </Section>

    <Section spacing="none" container="narrow">
      <Image
        src={d.cover}
        alt={d.coverAlt}
        width={1200}
        height={800}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="article__cover"
      />
    </Section>

    <Section spacing="compact" container="narrow">
      <div class="prose article__body">
        <Content />
      </div>
      {d.tags.length > 0 && (
        <p class="article__tags">
          <span class="article__tags-label">{t('common.tags')}: </span>
          {d.tags.map((tag, i) => (
            <>
              {i > 0 && <span aria-hidden="true">, </span>}
              <span class="article__tag">{tag}</span>
            </>
          ))}
        </p>
      )}
    </Section>

    <Section spacing="compact" container="narrow" tone="default">
      <nav class="article__nav" aria-label={t('a11y.articleNav')}>
        <div class="article__nav-item">
          {neighbours.older && (
            <a href={articlePath(neighbours.older)} class="article__nav-link" rel="prev">
              <span class="article__nav-label">
                <Icon name="chevron-left" size={16} />
                {t('articles.previous')}
              </span>
              <span class="article__nav-title">{neighbours.older.data.title}</span>
            </a>
          )}
        </div>
        <div class="article__nav-item article__nav-item--next">
          {neighbours.newer && (
            <a href={articlePath(neighbours.newer)} class="article__nav-link" rel="next">
              <span class="article__nav-label">
                {t('articles.next')}
                <Icon name="chevron-right" size={16} />
              </span>
              <span class="article__nav-title">{neighbours.newer.data.title}</span>
            </a>
          )}
        </div>
      </nav>
      <p class="article__all">
        <Button href={listPath} variant="secondary" icon="arrow-right">
          {t('actions.backToArticles')}
        </Button>
      </p>
    </Section>
  </article>
</BaseLayout>

<style>
  .article__head {
    padding-block-end: var(--space-6);
  }
  .article__head :global(.container) {
    display: grid;
    gap: var(--space-4);
  }
  .article__back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    min-height: var(--touch-target);
    margin-inline-start: -0.25em;
    font-size: var(--text-subheadline);
    font-weight: 500;
    text-decoration: none;
  }
  .article__back-link:hover {
    text-decoration: underline;
  }
  .article__title {
    font-size: clamp(var(--text-large-title), 4.5vw, 3rem);
    line-height: 1.1;
  }
  .article__lead {
    font-size: var(--text-title-3);
    line-height: 1.4;
    color: var(--label-secondary);
  }
  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    font-size: var(--text-footnote);
    line-height: var(--leading-footnote);
    color: var(--label-secondary);
  }
  .article__meta > div {
    display: inline-flex;
    gap: 0.35em;
  }
  .article__meta dt::after {
    content: ':';
  }
  .article__meta dd {
    margin: 0;
    color: var(--label);
  }
  .article__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: inset 0 0 0 1px var(--separator);
  }
  .article__body {
    margin-block-start: var(--space-2);
  }
  .article__tags {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--separator);
    font-size: var(--text-subheadline);
    color: var(--label-secondary);
  }
  .article__tags-label {
    font-weight: 600;
  }
  .article__nav {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--separator);
  }
  @media (min-width: 40em) {
    .article__nav {
      grid-template-columns: 1fr 1fr;
    }
  }
  .article__nav-item--next {
    text-align: end;
  }
  .article__nav-link {
    display: inline-grid;
    gap: var(--space-1);
    min-height: var(--touch-target);
    padding: var(--space-3);
    margin: calc(-1 * var(--space-3));
    border-radius: var(--radius-md);
    color: var(--label);
    text-decoration: none;
  }
  .article__nav-link:hover {
    background: var(--fill);
  }
  .article__nav-label {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-size: var(--text-footnote);
    color: var(--label-secondary);
  }
  .article__nav-item--next .article__nav-label {
    justify-content: flex-end;
  }
  .article__nav-title {
    font-weight: 600;
  }
  .article__all {
    margin-block-start: var(--space-6);
  }
</style>
