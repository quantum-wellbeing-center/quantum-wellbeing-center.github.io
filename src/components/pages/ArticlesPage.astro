---
/**
 * ArticlesPage: the paginated article list (9 per page). Page 1 is the list route; later pages
 * live at `<list>/<n>/`. The language switcher points at the other language's list.
 */
import type { Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { getRoute, otherLocale, useTranslations, type Locale } from '../../i18n';
import { getPage, type ArticleEntry } from '../../lib/content';
import Section from '../ui/Section.astro';
import ArticleCard from '../sections/ArticleCard.astro';
import PageIntro from '../sections/PageIntro.astro';
import Pagination from '../sections/Pagination.astro';

interface Props {
  lang: Locale;
  page: Page<ArticleEntry>;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);
const { data: copy } = await getPage(lang, 'articles');
const basePath = getRoute(lang, 'articles');
const title =
  page.currentPage > 1
    ? t('articles.pageTitle', { title: copy.title, page: page.currentPage })
    : copy.title;
const alternateUrl = getRoute(otherLocale(lang), 'articles');
const feedPath = lang === 'ro' ? '/rss.xml' : '/en/rss.xml';
const feedTitle = t('articles.feedTitle', { brand: site.brandName });
---

<BaseLayout
  lang={lang}
  pageKey="articles"
  title={title}
  description={copy.description}
  alternateUrl={alternateUrl}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={feedTitle} href={feedPath} />
  </Fragment>

  <PageIntro title={copy.title} lead={copy.subheading}>
    <p class="articles-feed">
      <a href={feedPath} class="articles-feed__link">
        {t('a11y.rss')}
      </a>
    </p>
  </PageIntro>

  <Section spacing="compact" class="articles" aria-label={copy.title}>
    {page.data.length === 0 ? (
      <p class="articles__empty">{t('articles.empty')}</p>
    ) : (
      <ul class="articles__grid" role="list">
        {page.data.map((entry, index) => (
          <li>
            <ArticleCard lang={lang} entry={entry} headingLevel="h2" eager={index === 0} />
          </li>
        ))}
      </ul>
    )}
    <Pagination
      lang={lang}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      basePath={basePath}
    />
  </Section>
</BaseLayout>

<style>
  .articles-feed {
    font-size: var(--text-footnote);
  }
  .articles-feed__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  .articles {
    padding-block-end: clamp(var(--space-7), 8vw, var(--space-9));
  }
  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5) var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .articles__grid > li {
    display: flex;
  }
  .articles__grid > li > :global(*) {
    width: 100%;
  }
  .articles__empty {
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--bg-secondary);
    text-align: center;
    color: var(--label-secondary);
  }
</style>
