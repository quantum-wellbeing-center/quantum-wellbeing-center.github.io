---
/**
 * FaqPage: one flat list of short questions as native details/summary accordions (modelled on
 * the FAQ on quantumclinic.ro), FAQPage structured data with plain-text answers, and a CTA band
 * that opens the WhatsApp chat on the "other question" topic next to the phone number.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';
import { getFaqs, getPage, jsonLd, markdownToText } from '../../lib/content';
import Section from '../ui/Section.astro';
import CtaBand from '../sections/CtaBand.astro';
import FaqAccordion from '../sections/FaqAccordion.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { data: page } = await getPage(lang, 'faq');
const faqs = await getFaqs(lang);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang === 'ro' ? 'ro-RO' : 'en',
  mainEntity: faqs.map((entry) => ({
    '@type': 'Question',
    name: entry.data.question,
    acceptedAnswer: { '@type': 'Answer', text: markdownToText(entry.body ?? '') },
  })),
};
---

<BaseLayout lang={lang} pageKey="faq" title={page.title} description={page.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(structuredData)} />
  </Fragment>

  <PageIntro title={page.title} lead={page.subheading} />

  <Section id="faq-list" spacing="compact">
    <div class="faq-list">
      <FaqAccordion entries={faqs} headingLevel="h2" />
    </div>
  </Section>

  <CtaBand
    lang={lang}
    heading={page.cta.heading}
    text={page.cta.text}
    topic="other"
    bookingLabel={t('actions.writeWhatsApp')}
    id="faq-cta"
  />
</BaseLayout>

<style>
  .faq-list {
    max-width: 48rem;
  }
</style>
